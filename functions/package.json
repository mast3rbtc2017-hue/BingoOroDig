{
  "name": "bingoorodig-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node lib/server.js",
    "dev": "npm run build && node lib/server.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,hosting",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "firebase-functions": "^6.3.0",
    "typescript": "^5.7.3"
  }
}
